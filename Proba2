async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data.clear()
    await update.message.reply_text(
        "Пришлите <b>DXF-файл</b> с полилинией (база).\n\n"
        "После этого пришлите <b>TXT</b> с точками.\n\n"
        "Поддерживаемые форматы строк:\n"
        "<code>1 100.5 200.3 15.0</code>\n"
        "<code>1,100.5,200.3,15.0</code>\n"
        "<code>1 100,5 200,3 15,0</code>\n"
        "<code>100,5 200,3 15,0</code>  (без номера)\n\n"
        "Красный цвет — если отклонение по высоте &gt; 18.\n\n"
        "/cancel — отмена",
        parse_mode="HTML",
    )
    return WAITING_DXF_BASE


async def handle_base_dxf(update: Update, context: ContextTypes.DEFAULT_TYPE):
    document = update.message.document
    if not document or not (document.file_name or "").lower().endswith(".dxf"):
        await update.message.reply_text("Нужен файл с расширением .dxf")
        return WAITING_DXF_BASE

    user_id = update.effective_user.id
    await update.message.reply_text("Сохраняю базу...")

    file = await context.bot.get_file(document.file_id)
    dxf_path = WORK_DIR / f"user_{user_id}_base.dxf"
    await file.download_to_drive(dxf_path)

    try:
        doc = ezdxf.readfile(dxf_path)
        has_poly = any(e.dxftype() == "LWPOLYLINE" for e in doc.modelspace())
        if not has_poly:
            await update.message.reply_text(
                "В файле не найдена полилиния (LWPOLYLINE).\nПришлите другой DXF."
            )
            return WAITING_DXF_BASE
    except Exception as e:
        await update.message.reply_text(f"Не удалось прочитать DXF: {e}")
        return WAITING_DXF_BASE

    context.user_data["base_dxf"] = str(dxf_path)
    await update.message.reply_text(
        "База принята.\nТеперь пришлите TXT-файл с точками."
    )
    return WAITING_POINTS


async def handle_points(update: Update, context: ContextTypes.DEFAULT_TYPE):
    base_path = context.user_data.get("base_dxf")
    if not base_path:
        await update.message.reply_text("Сначала пришлите DXF-базу. Нажмите /start")
        return ConversationHandler.END

    document = update.message.document
    if not document or not (document.file_name or "").lower().endswith(".txt"):
        await update.message.reply_text("Нужен файл с расширением .txt")
        return WAITING_POINTS

    user_id = update.effective_user.id
    await update.message.reply_text("Считаю отклонения и рисую аннотации...")

    file = await context.bot.get_file(document.file_id)
    txt_path = WORK_DIR / f"user_{user_id}_points.txt"
    await file.download_to_drive(txt_path)

    try:
        text = txt_path.read_text(encoding="utf-8", errors="ignore")
    except Exception as e:
        await update.message.reply_text(f"Не удалось прочитать TXT: {e}")
        return ConversationHandler.END

    points = parse_points_from_txt(text)
    if not points:
        await update.message.reply_text("Не найдено ни одной валидной точки.")
        return ConversationHandler.END

    try:
        doc = ezdxf.readfile(base_path)
        msp = doc.modelspace()

        polyline = next((e for e in msp if e.dxftype() == "LWPOLYLINE"), None)
        if polyline is None:
            await update.message.reply_text("Полилиния не найдена.")
            return ConversationHandler.END

        vertices = [
            Vec3(v[0], v[1], v[2] if len(v) > 2 else 0.0)
            for v in polyline.get_points("xyz")
        ]

        processed = 0
        for point_id, pt in points:
            closest, seg_idx, _ = find_closest_on_polyline(pt, vertices)
            if closest is None:
                continue

            # Сторона (В / Н)
            v_point = Vec3(pt.x - closest.x, pt.y - closest.y, 0)
            start_seg = vertices[seg_idx]
            end_seg = vertices[seg_idx + 1]
            v_seg = Vec3(end_seg.x - start_seg.x, end_seg.y - start_seg.y, 0)

            cross = v_seg.x * v_point.y - v_seg.y * v_point.x
            litera = "В" if cross > 0 else "Н"

            height_diff = abs(pt.z - closest.z)

            angle = (end_seg - start_seg).angle_deg
            if 90 < angle < 270:
                angle += 180

            add_annotation(doc, point_id, closest, angle, height_diff, litera)
            processed += 1

        out_path = WORK_DIR / f"user_{user_id}_result.dxf"
        doc.saveas(out_path)
        context.user_data["last_result"] = str(out_path)

        keyboard = InlineKeyboardMarkup([
            [InlineKeyboardButton("Сделать PDF", callback_data="make_pdf")]
        ])

        await update.message.reply_text(f"Готово! Обработано точек: {processed}")

        with open(out_path, "rb") as f:
            await update.message.reply_document(
                document=f,
                filename="Отклонения.dxf",
                caption="DXF с аннотациями",
                reply_markup=keyboard,
            )

    except Exception as e:
        logger.exception("Ошибка обработки")
        await update.message.reply_text(f"Ошибка при обработке:\n{e}")
        traceback.print_exc()

    return ConversationHandler.END


async def button_make_pdf(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    result_path = context.user_data.get("last_result")
    if not result_path or not Path(result_path).exists():
        await query.edit_message_caption(caption="Файл результата не найден. Начните заново /start")
        return

    await query.edit_message_caption(caption="Создаю PDF...")

    pdf_path = Path(result_path).with_suffix(".pdf")
    success = dxf_to_pdf(Path(result_path), pdf_path)

    if success and pdf_path.exists():
        with open(pdf_path, "rb") as f:
            await context.bot.send_document(
                chat_id=query.message.chat_id,
                document=f,
                filename="Отклонения.pdf",
                caption="PDF готов",
            )
        await query.edit_message_caption(caption="PDF отправлен")
    else:
        await query.edit_message_caption(caption="Не удалось создать PDF")


async def cancel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data.clear()
    await update.message.reply_text("Операция отменена.\nНажмите /start чтобы начать заново.")
    return ConversationHandler.END


# ------------------------------------------------------------------
# Запуск
# ------------------------------------------------------------------

def main():
    if BOT_TOKEN == "ВАШ_ТОКЕН_ОТ_BOTFATHER":
        print("Ошибка: вставьте настоящий токен в переменную BOT_TOKEN")
        return

    app = Application.builder().token(BOT_TOKEN).build()

    conv = ConversationHandler(
        entry_points=[CommandHandler("start", start)],
        states={
            WAITING_DXF_BASE: [
                MessageHandler(filters.Document.ALL, handle_base_dxf),
            ],
            WAITING_POINTS: [
                MessageHandler(filters.Document.ALL, handle_points),
            ],
        },
        fallbacks=[CommandHandler("cancel", cancel)],
        allow_reentry=True,
    )

    app.add_handler(conv)
    app.add_handler(CallbackQueryHandler(button_make_pdf, pattern="^make_pdf$"))
    app.add_handler(CommandHandler("cancel", cancel))

    print("Бот запущен...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
