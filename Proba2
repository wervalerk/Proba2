def build_pdf(points, c: dict, out: Path):
    if not points:
        return

    xs = [p[0] for p in points]
    ys = [p[1] for p in points]
    
    fig, ax = plt.subplots(figsize=(8.27, 11.69), dpi=300)
    
    ax.scatter(xs, ys, c='black', s=10, zorder=3)

    if c["polyline"] and len(points) >= 2:
        ax.plot(xs, ys, c='blue', linewidth=0.5, zorder=2)

    if c["labels"]:
        for i, (x, y) in enumerate(zip(xs, ys), 1):
            ax.text(x, y, str(i), fontsize=6, ha='left', va='bottom', zorder=4)

    ax.set_aspect('equal', adjustable='datalim')
    ax.grid(True, linestyle='--', alpha=0.5)
    ax.set_xlabel('X')
    ax.set_ylabel('Y')
    ax.margins(0.05)
    
    fig.savefig(out, format='pdf', bbox_inches='tight')
    plt.close(fig)
