WAITING_POINTS = 2


# ------------------------------------------------------------------
# Парсинг точек
# ------------------------------------------------------------------

def parse_points_from_txt(text: str) -> list[tuple[str, Vec3]]:
    """
    Поддерживает форматы:
        1 100.5 200.3 15.0
        1,100.5,200.3,15.0
        1 100,5 200,3 15,0
        1;100,5;200,3;15,0
        100,5 200,3 15,0          ← без номера
    """
    points = []
    auto_num = 1

    def normalize_number(s: str) -> str:
        """Заменяет запятую на точку, если это десятичный разделитель."""
        s = s.strip()
        if "," in s and "." not in s:
            s = s.replace(",", ".")
        return s

    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue

        parts = re.split(r"[,;\s]+", line)
        parts = [p for p in parts if p]

        if len(parts) < 2:
            continue

        try:
            parts = [normalize_number(p) for p in parts]

            point_id = str(auto_num)
            coords = parts

            # Пробуем определить номер точки в начале строки
            if len(parts) >= 3:
                try:
                    first_val = float(parts[0])
                    if abs(first_val - round(first_val)) < 1e-9:
                        point_id = str(int(round(first_val)))
                        coords = parts[1:]
                except ValueError:
                    pass

            if len(coords) < 2:
                continue

            x = float(coords[0])
            y = float(coords[1])
            z = float(coords[2]) if len(coords) >= 3 else 0.0

            points.append((point_id, Vec3(x, y, z)))
            auto_num += 1

        except ValueError:
            continue

    return points


# ------------------------------------------------------------------
# Геометрия
# ------------------------------------------------------------------

def closest_point_on_segment(point: Vec3, start: Vec3, end: Vec3) -> Vec3:
    seg = end - start
    length2 = seg.magnitude_square
    if length2 < 1e-12:
        return start
    t = max(0.0, min(1.0, (point - start).dot(seg) / length2))
    return start + seg * t


def find_closest_on_polyline(point: Vec3, vertices: list[Vec3]):
    min_dist = float("inf")
    closest = None
    seg_idx = 0

    for i in range(len(vertices) - 1):
        start = vertices[i]
        end = vertices[i + 1]
        proj = closest_point_on_segment(point, start, end)
        dist = point.distance(proj)
        if dist < min_dist:
            min_dist = dist
            closest = proj
            seg_idx = i

    return closest, seg_idx, min_dist


def create_arrow_block(doc, block_name: str = "DIM_ARROW"):
    if block_name in doc.blocks:
        return
    blk = doc.blocks.new(name=block_name)
    blk.add_lwpolyline(
        [(0, 0), (-0.6, 1.4), (0.6, 1.4)],
        close=True,
        dxfattribs={"layer": "0"},
    )


def add_annotation(doc, point_id: str, pline_pt: Vec3, angle: float, dist: float, litera: str):
    """Рисует стрелку + текст: номер точки, литера, отклонение."""
    msp = doc.modelspace()

    for name, color in [("OFFSETS_OK", 3), ("OFFSETS_ERR", 1)]:
        if name not in doc.layers:
            doc.layers.add(name=name, color=color)

    create_arrow_block(doc)

    layer_name = "OFFSETS_ERR" if dist > HEIGHT_THRESHOLD else "OFFSETS_OK"

    text = f"{point_id}\n{litera} {dist:.2f}"

    rad = math.radians(angle)
    offset = Vec3(-9 * math.sin(rad), 9 * math.cos(rad), 0)
    text_pos = pline_pt + offset

    # Стрелка
    msp.add_blockref(
        "DIM_ARROW",
        pline_pt,
        dxfattribs={
            "layer": layer_name,
            "rotation": angle,
            "xscale": 2.2,
            "yscale": 2.2,
        },
    )

    # Текст
    mtext = msp.add_mtext(text, dxfattribs={
        "layer": layer_name,
        "char_height": 2.0,
        "style": "Standard",
        "attachment_point": 5,
    })
    mtext.set_location(text_pos, rotation=angle)


def dxf_to_pdf(dxf_path: Path, pdf_path: Path) -> bool:
    try:
        doc = ezdxf.readfile(dxf_path)
        drawing_matplotlib.qsave(
            doc.modelspace(),
            str(pdf_path),
            dpi=150,
            bg="#FFFFFF",
        )
        return True
    except Exception as e:
        logger.error(f"Ошибка PDF: {e}")
        return False


